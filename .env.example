# ==============================================================================
# NEOCONTA — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copie este archivo a `.env.production` (o `.env.local`) y complete los valores
# correspondientes antes de iniciar el sistema en un nuevo servidor.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS Y PERSISTENCIA
# ------------------------------------------------------------------------------
# URL de conexión SQLite de Prisma (por defecto prisma/neoconta.db)
DATABASE_URL="file:./prisma/neoconta.db"

# ------------------------------------------------------------------------------
# 2. SEGURIDAD Y AUTENTICACIÓN
# ------------------------------------------------------------------------------
# Clave secreta para firma y verificación de tokens JWT de sesión (mínimo 32 caracteres)
JWT_SECRET="generate-a-strong-secret-key-at-least-32-chars-long"

# Clave maestra simétrica (AES-256) para cifrar credenciales fiscales AFIP/ARCA y tokens OAuth
AFIP_ENCRYPTION_KEY="32-bytes-encryption-key-for-afip-and-oauth-storage"

# Token secreto para validar llamadas internas entre el frontend y el microservicio de Data Science
DS_INTERNAL_SECRET="generate-strong-shared-secret-between-nextjs-and-ds"

# Secreto de autorización para endpoints de cron (WhatsApp reminders, ledger updates, etc.)
CRON_SECRET="generate-strong-random-cron-secret-token"

# ------------------------------------------------------------------------------
# 3. DOMINIO Y URL PÚBLICA
# ------------------------------------------------------------------------------
# URL canónica base de la aplicación para redirecciones OAuth y callbacks
NEXT_PUBLIC_APP_URL="https://neoconta.com.ar"

# ------------------------------------------------------------------------------
# 4. INTEGRACIONES DE INTELIGENCIA ARTIFICIAL Y BÚSQUEDA (COMMENTOR & COMMANDER)
# ------------------------------------------------------------------------------
# Google Gemini API Key (usada para análisis de sentimiento, categorización y reportes)
GEMINI_API_KEY="your-google-gemini-api-key"

# Google Custom Search API Key y Search Engine ID (usada en auditoría web de Commentor)
GOOGLE_SEARCH_KEY="your-google-custom-search-api-key"
GOOGLE_SEARCH_CX="your-google-custom-search-engine-id"

# Serper API Key (opcional, motor alternativo para búsqueda de menciones web)
SERPER_API_KEY=""

# ------------------------------------------------------------------------------
# 5. CONEXIONES OAUTH SOCIALES (COMMENTOR REPUTATION & REVIEWS)
# ------------------------------------------------------------------------------
# Google Cloud Platform OAuth 2.0 Credentials (Google Business Profile & Drive)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Meta for Developers App Credentials (Facebook Pages & Instagram Professional)
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"

# Microsoft Azure OAuth Credentials (opcional, para integración OneDrive de Commander)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 6. SERVICIO DE CORREO ELECTRÓNICO (SMTP)
# ------------------------------------------------------------------------------
# Configuración del servidor de correo para notificaciones y contacto
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="notificaciones@neoconta.com.ar"
SMTP_PASSWORD="your-secure-smtp-password"
CONTACT_EMAIL="contacto@neoconta.com.ar"
